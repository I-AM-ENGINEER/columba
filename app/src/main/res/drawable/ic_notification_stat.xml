<?xml version="1.0" encoding="utf-8"?>
<!--
  Notification small icon (status bar / heads-up). A pure-white single-color
  silhouette of the Columba mesh: the SAME group transform and node/link
  geometry as ic_launcher_foreground (so it reads as the identical mark),
  minus the translucent "glow" halos, because a notification small icon must
  be a single opaque color (the system tints it) and renders at ~24dp where
  translucent halos smear. Strokes are kept at the foreground's weight.
-->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    android:width="24dp"
    android:height="24dp"
    android:viewportWidth="512"
    android:viewportHeight="512">

    <group
        android:scaleX="0.65"
        android:scaleY="0.65"
        android:pivotX="256"
        android:pivotY="256"
        android:translateX="6"
        android:translateY="-10">

        <!-- Connecting lines -->
        <path
            android:pathData="M93.53,128.431 C94.162,128.471 271.37,194.336 271.29,193.077"
            android:strokeWidth="9"
            android:strokeColor="#FFFFFF"
            android:strokeLineCap="round"
            android:fillColor="#00000000" />
        <path
            android:pathData="M270.75,193.487 C270.902,226.855 231.12,378.151 216.617,402.841"
            android:strokeWidth="9"
            android:strokeColor="#FFFFFF"
            android:strokeLineCap="round"
            android:fillColor="#00000000" />
        <path
            android:pathData="M270.923,193.326 C281.938,183.739 347.714,144.654 356.069,139.108"
            android:strokeWidth="9"
            android:strokeColor="#FFFFFF"
            android:strokeLineCap="round"
            android:fillColor="#00000000" />
        <path
            android:pathData="M405.781,182.043 C381.14,160.276 371.817,147.932 356.85,138.219"
            android:strokeWidth="9"
            android:strokeColor="#FFFFFF"
            android:strokeLineCap="round"
            android:fillColor="#00000000" />

        <!-- Solid node centers (sized up vs the launcher so the mesh reads at 24dp) -->
        <path
            android:pathData="M406.658,182.257 m-16,0 a16,16 0,1 1,32 0 a16,16 0,1 1,-32 0"
            android:fillColor="#FFFFFF" />
        <path
            android:pathData="M356.658,138.257 m-18,0 a18,18 0,1 1,36 0 a18,18 0,1 1,-36 0"
            android:fillColor="#FFFFFF" />
        <path
            android:pathData="M270.658,193.257 m-13,0 a13,13 0,1 1,26 0 a13,13 0,1 1,-26 0"
            android:fillColor="#FFFFFF" />
        <path
            android:pathData="M214.658,403.257 m-13,0 a13,13 0,1 1,26 0 a13,13 0,1 1,-26 0"
            android:fillColor="#FFFFFF" />
        <path
            android:pathData="M93.506,128.312 m-11,0 a11,11 0,1 1,22 0 a11,11 0,1 1,-22 0"
            android:fillColor="#FFFFFF" />
        <path
            android:pathData="M230.655,178.527 m-12,0 a12,12 0,1 1,24 0 a12,12 0,1 1,-24 0"
            android:fillColor="#FFFFFF" />
    </group>
</vector>
